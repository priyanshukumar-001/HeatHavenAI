{
  "name": "heathaven-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Urban Heat Relief, Shade Mapping & Bilingual Gemini AI Concierge for Outdoor Gig Workers & Commuters",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "build": "npm --prefix client run build",
    "dev": "node -e \"console.log('\\n🚀 To run HeatHaven AI:\\nTerminal 1: npm run dev:server\\nTerminal 2: npm run dev:client\\n')\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "test": "npm --prefix server test",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "seed": "npm --prefix server run seed:manual"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.10.1",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "keywords": [
    "heatwave",
    "gemini-ai",
    "google-gemini",
    "relief-map",
    "urban-heat-island",
    "gig-workers",
    "geospatial",
    "mongodb-2dsphere",
    "react-19",
    "leaflet",
    "recharts",
    "tailwind-css"
  ],
  "author": "Priyanshu Kumar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/priyanshukumar-001/HeatHavenAI/issues"
  },
  "homepage": "https://github.com/priyanshukumar-001/HeatHavenAI#readme"
}
